# Copia este archivo como .env.local y rellena con tus valores reales.
# Nunca subas .env.local (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Solo para Server Actions/Route Handlers (nunca NEXT_PUBLIC_, nunca
# en el navegador). La ves en Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=service_role_placeholder

# Email con acceso a /admin (aprobar cuentas nuevas). Solo uno, sin
# sistema de roles: para un unico operador es suficiente.
ADMIN_EMAIL=tu@email.com

# Notificaciones por email a los padres (resend.com, plan gratuito).
# API key en Resend > API Keys. Requiere el dominio koru.onl
# verificado en Resend > Domains. También se usa como contraseña SMTP
# para los correos de login/invitación de Supabase Auth (ver
# supabase/config.toml > [auth.email.smtp]).
RESEND_API_KEY=resend_placeholder

# URL real de la app en produccion, para los enlaces dentro de los
# emails. En local puede quedar sin definir (usa localhost por defecto).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push (Web Push nativo del navegador + VAPID, sin
# proveedor de terceros ni cuenta que crear). Generar un par de claves
# UNA VEZ con: npx web-push generate-vapid-keys
# La publica va tambien en NEXT_PUBLIC_ porque el navegador la
# necesita para suscribirse; la privada nunca debe exponerse al cliente.
VAPID_PUBLIC_KEY=vapid_public_placeholder
VAPID_PRIVATE_KEY=vapid_private_placeholder
NEXT_PUBLIC_VAPID_PUBLIC_KEY=vapid_public_placeholder

# Traducción automática de mensajes del chat, para familias
# extranjeras. Cuenta gratuita en deepl.com/pro-api (500.000
# caracteres/mes). Las keys de plan gratuito terminan en ":fx" y usan
# un dominio de API distinto — el código ya lo detecta solo.
DEEPL_API_KEY=deepl_api_key_placeholder
