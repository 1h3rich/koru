# Copia este archivo como .env.local y rellena con tus valores reales.
# Nunca subas .env.local (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Solo para Server Actions/Route Handlers (nunca NEXT_PUBLIC_, nunca
# en el navegador). La ves en Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=service_role_placeholder

# Email con acceso a /admin (aprobar cuentas nuevas). Solo uno, sin
# sistema de roles: para un unico operador es suficiente.
ADMIN_EMAIL=tu@email.com

# Notificaciones por email a los padres (resend.com, plan gratuito).
# API key en Resend > API Keys.
RESEND_API_KEY=resend_placeholder

# URL real de la app en produccion, para los enlaces dentro de los
# emails. En local puede quedar sin definir (usa localhost por defecto).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
